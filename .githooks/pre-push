#!/bin/sh
# Общий pre-push hook: PROJECT_STATUS.md не должен протухать в main/master.
#
# Отличие от прежней версии: хук не просто блокирует, а САМ дописывает секцию
# «Авто-сводка (git)» через status-updater.sh. Человеку/агенту остаётся дописать
# смысл и закоммитить — файл уже заполнен фактами.
#
# Источник: /opt/shared/hooks/pre-push (ставится через install-hooks.sh).
# Разовый обход: git push --no-verify

STATUS_FILE="PROJECT_STATUS.md"
STALE_THRESHOLD="${STATUS_STALE_THRESHOLD:-5}"
ZERO="0000000000000000000000000000000000000000"

# Ищем status-updater: сначала общий, потом локальный в репо.
UPDATER=""
for cand in /opt/shared/hooks/status-updater.sh scripts/project-status-summary.sh; do
  [ -x "$cand" ] && { UPDATER="$cand"; break; }
done

while read local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue

  branch=$(echo "$remote_ref" | sed 's,^refs/heads/,,')
  case "$branch" in
    main|master) ;;
    *) continue ;;
  esac

  if [ ! -f "$STATUS_FILE" ]; then
    echo ""
    echo "pre-push blocked: $STATUS_FILE отсутствует в корне репо."
    echo "  Шаблон: /root/.openclaw/workspace/scripts/PROJECT_STATUS.template.md"
    echo "  Разовый обход: git push --no-verify"
    echo ""
    exit 1
  fi

  if [ "$remote_sha" = "$ZERO" ]; then
    range="$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  commit_count=$(git rev-list --count "$range" 2>/dev/null)
  [ -z "$commit_count" ] && commit_count=0
  status_touched=$(git diff --name-only "$range" 2>/dev/null | grep -Fxc "$STATUS_FILE" || true)
  [ -z "$status_touched" ] && status_touched=0

  if [ "$commit_count" -ge "$STALE_THRESHOLD" ] && [ "$status_touched" -eq 0 ]; then
    echo ""
    echo "pre-push blocked: $commit_count коммитов уходит в $branch, но $STATUS_FILE не обновлялся."

    if [ -n "$UPDATER" ]; then
      echo "  Заполняю факты автоматически ($UPDATER)..."
      if "$UPDATER" >/dev/null 2>&1; then
        echo "  ✅ Секция «Авто-сводка (git)» в $STATUS_FILE обновлена."
        echo "     Допиши смысл (что сделано / что дальше) и закоммить:"
        echo "       git add $STATUS_FILE && git commit -m 'docs: обновить PROJECT_STATUS' && git push"
      else
        echo "  ⚠️  Автогенерация не удалась — обнови $STATUS_FILE вручную."
      fi
    else
      echo "  status-updater не найден — обнови $STATUS_FILE вручную."
    fi

    echo "  Разовый обход: git push --no-verify"
    echo ""
    exit 1
  fi
done

exit 0
